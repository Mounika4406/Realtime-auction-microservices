# Real-Time Auction Microservices Platform Configuration Schema
# (Placeholder values only - do not commit sensitive production secrets)

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here

# API Gateway Configuration
API_GATEWAY_PORT=8000

# PostgreSQL Database Connection Strings
AUTH_DATABASE_URL=postgresql://postgres:postgres@postgres-auth:5432/db_auth
AUCTION_DATABASE_URL=postgresql://postgres:postgres@postgres-auction:5432/db_auction
NOTIFICATION_DATABASE_URL=postgresql://postgres:postgres@postgres-notification:5432/db_notification

# RabbitMQ Message Broker URL
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Microservice Ports (Internal & Optional Host Mappings)
AUTH_SERVICE_PORT=8001
AUCTION_SERVICE_PORT=8002
BIDDING_SERVICE_PORT=8003
NOTIFICATION_SERVICE_PORT=8004
